# =============================================
# AI 数字人情感陪护系统 - 环境变量配置示例
# =============================================
# 使用方法：
#   1. 复制此文件并重命名为 .env
#   2. 填写真实的 API Key 等敏感信息
#   3. .env 文件已加入 .gitignore，不会被提交到代码仓库

# ── 阿里云 DashScope API Key（必填）────────
# 用于千问 LLM 对话 + CosyVoice TTS 语音合成
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ── TTS 语音合成（可选）──────────────────
# auto：优先使用已配置的 CosyVoice，同时在 macOS 开发机提供系统中文音色。
# 也可固定为 cosyvoice、macos_say 或 browser。
TTS_PROVIDER=auto
# 默认音色可填写完整 ID（如 cosyvoice:longxiaochun）或 macOS 音色名（如 Tingting）。
TTS_DEFAULT_VOICE=Tingting
# macOS 系统音色语速，允许范围 120-260。
TTS_RATE=185

# ── 智能体大模型（可选）──────────────────
# 默认使用 DashScope OpenAI 兼容接口，也可以替换成其他兼容服务
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── 服务端口（可选，默认 8800）────────
# SERVER_PORT=8800

# ── 数据库路径（可选，默认 data/users.db）────────
# DB_PATH=data/users.db

# ── 推理设备（可选，默认自动检测）────────
# Apple Silicon 自动选择 MPS；遇到模型不支持的算子时会在首次推理后切换 CPU。
# 服务器希望行为完全可预测时可显式设置 cpu 或 cuda。
# DEVICE=auto   # auto / cpu / cuda / mps

# ── 正式数字人情感反应模型（可选）────────
# 默认读取 digital_human_engine/checkpoints_v2/best_model.pt
# 权重文件不提交到 Git；可以使用绝对路径覆盖默认位置
# FACE_DRIVER_CHECKPOINT=digital_human_engine/checkpoints_v2/best_model.pt

# RAG 管理页面默认只读。仅在需要在线维护知识语料时设置高强度随机令牌。
# 管理令牌只用于 X-RAG-Admin-Token 请求头，不要提交真实值。
# RAG_ADMIN_TOKEN=

# ── RAG 本地语义模型（可选）────────
# 指向已经下载到服务器的 Sentence Transformers 模型目录。
# 未设置、依赖缺失或模型加载失败时自动使用 BM25，不会在线下载模型。
# RAG_EMBEDDING_MODEL_PATH=/absolute/path/to/embedding-model
# 正式权重 SHA-256；设置为 off 可关闭摘要校验（不推荐）
# FACE_DRIVER_CHECKPOINT_SHA256=84fa5cabb83155d3f600fac214aadaeb79068606e329f3d8cf4640c21f475e90

# ── 日志级别（可选）────────
# LOG_LEVEL=INFO   # DEBUG / INFO / WARNING / ERROR
