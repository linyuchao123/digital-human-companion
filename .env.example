# =============================================
# AI 数字人情感陪护系统 - 环境变量配置示例
# =============================================
# 使用方法：
#   1. 复制此文件并重命名为 .env
#   2. 填写真实的 API Key 等敏感信息
#   3. .env 文件已加入 .gitignore，不会被提交到代码仓库

# ── API Key 配置───────────────────────────
# 同一个 DashScope Key 同时用于千问 LLM 和 Qwen3/CosyVoice TTS 时，只填写这一项。
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# DeepSeek 是主对话模型；千问是备用模型。两者均不可用时自动使用离线回复。
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# TTS 专用密钥；留空时使用上面的共用 DashScope 密钥。
TTS_API_KEY=

# ── TTS 语音合成（可选）──────────────────
# auto：优先使用已配置的 Qwen3 角色音色，同时保留 CosyVoice 与 macOS 系统音色。
# 也可固定为 qwen3_tts、cosyvoice、macos_say 或 browser。
TTS_PROVIDER=auto
# 推荐二次元少女 Chelsie；未配置云端密钥时会自动回退到本机 Tingting。
TTS_DEFAULT_VOICE=qwen3_tts:Chelsie
# Qwen3 指令控制模型会为不同角色音色附加俏皮、元气或温柔的表达指令。
TTS_QWEN3_MODEL=qwen3-tts-instruct-flash
# macOS 系统音色语速，允许范围 120-260。
TTS_RATE=185

# ── 智能体大模型（可选）──────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── 服务端语音识别（可选）──────────────────
# 安装 speech 依赖后自动使用服务端录音；未安装则使用浏览器识别。
ASR_MODEL=paraformer-zh
ASR_DEVICE=cpu
# 模型默认缓存到 models/asr，可提前使用 scripts/prepare_asr_models.py 下载。
# MODELSCOPE_CACHE=/absolute/path/to/modelscope-cache

# ── 服务端口（可选，默认 8800）────────
# SERVER_PORT=8800

# ── 数据库路径（可选，默认 data/users.db）────────
# DB_PATH=data/users.db

# ── 推理设备（可选，默认自动检测）────────
# Apple Silicon 自动选择 MPS；遇到模型不支持的算子时会在首次推理后切换 CPU。
# 服务器希望行为完全可预测时可显式设置 cpu 或 cuda。
# DEVICE=auto   # auto / cpu / cuda / mps

# ── 正式数字人情感反应模型（可选）────────
# 默认读取 digital_human_engine/checkpoints_v2/best_model.pt
# 权重文件不提交到 Git；可以使用绝对路径覆盖默认位置
# FACE_DRIVER_CHECKPOINT=digital_human_engine/checkpoints_v2/best_model.pt

# RAG 管理页面默认只读。仅在需要在线维护知识语料时设置高强度随机令牌。
# 管理令牌只用于 X-RAG-Admin-Token 请求头，不要提交真实值。
# RAG_ADMIN_TOKEN=

# ── RAG 本地语义模型（可选）────────
# 指向已经下载到服务器的 Sentence Transformers 模型目录。
# 未设置、依赖缺失或模型加载失败时自动使用 BM25，不会在线下载模型。
# RAG_EMBEDDING_MODEL_PATH=/absolute/path/to/embedding-model
# 正式权重 SHA-256；设置为 off 可关闭摘要校验（不推荐）
# FACE_DRIVER_CHECKPOINT_SHA256=84fa5cabb83155d3f600fac214aadaeb79068606e329f3d8cf4640c21f475e90

# ── 日志级别（可选）────────
# LOG_LEVEL=INFO   # DEBUG / INFO / WARNING / ERROR
